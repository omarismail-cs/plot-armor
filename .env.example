# Copy to .env for local unpacked dev (never commit .env).
# Or set OpenAI/TMDB in Extension options.

OPENAI_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# False-positive ingest — required for "not a spoiler?" → Supabase (see supabase/README.md)
FALSE_POSITIVE_INGEST_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-false-positive
FALSE_POSITIVE_INGEST_KEY=
